      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <odom_publish_frequency>30</odom_publish_frequency>
        <odom_topic>/drone/odometry</odom_topic>
        <odom_frame>map</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
      </plugin>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>base_link</parent_link>
        <child_model>red_package</child_model>
        <child_link>link</child_link>
        <initial_attach>false</initial_attach>
        <attach_topic>/drone/gripper/attach</attach_topic>
        <detach_topic>/drone/gripper/detach</detach_topic>
        <output_topic>/drone/gripper/state</output_topic>
      </plugin>
    </model>
    <model name="external_camera">
      <static>true</static>
      <pose>4.5 -3 5 0 0.5 1.5707963</pose>
      <link name="camera">
        <sensor name="external_rgb" type="camera">
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <topic>/drone/camera/external/image</topic>
          <camera>
            <horizontal_fov>1.5</horizontal_fov>
            <image>
              <width>256</width>
              <height>256</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>30</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>